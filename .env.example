# Copy to .env. Keep credentials on this machine; never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Direct OpenAI by default. For Windows enterprise, supply the approved
# OpenAI-compatible /v1 endpoint and exact model alias if required.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: separate upstream credential/model for the direct-call check.
# Leave blank to use OPENAI_API_KEY / OPENAI_MODEL when the normal route is direct.
# If OPENAI_BASE_URL points to an enterprise gateway, set both DIRECT values
# with separate upstream OpenAI credentials/model for this optional check.
OPENAI_DIRECT_API_KEY=
OPENAI_DIRECT_MODEL=

DI_HOST=127.0.0.1
DI_PORT=8003
DI_DATA_DIR=./data
DI_MODEL_TIMEOUT_SECONDS=120
DI_JOB_TIMEOUT_SECONDS=1800
DI_MAX_MODEL_REQUESTS=60
DI_MAX_UPLOAD_MB=200
DI_MAX_FILES=2000
# Set to the model's real context window. Older tool results are cleared only near this limit.
DI_CONTEXT_TOKEN_LIMIT=200000
DI_RESPONSE_TOKEN_RESERVE=16000
DI_TOOL_RESULT_BYTES=16000
DI_IMAGE_TOKEN_ESTIMATE=8192
DI_INSPECTION_CELLS=1000000
DI_INSPECTION_SECONDS=30
DI_MAX_SUBAGENTS=0
DI_SUBAGENT_REQUESTS=12
# Blank for loopback workstation use. Set a strong token before binding
# to a network interface; the browser will request it once per session.
DI_ACCESS_TOKEN=
# Optional: extra host names the browser uses to reach the app (comma-separated).
# Blank allows only localhost/127.0.0.1/::1, or any host when DI_ACCESS_TOKEN is set.
DI_ALLOWED_HOSTS=
# Optional: extra browser origins, e.g. https://payroll.example.com behind a TLS proxy.
DI_ALLOWED_ORIGINS=
# Optional corporate CA bundle, if OS trust alone is insufficient.
# SSL_CERT_FILE=C:/path/to/corporate-ca-bundle.pem

# Deadline for killable parser/writer subprocesses.
DI_TOOL_TIMEOUT_SECONDS=110
# Offline tokenizer assets: run scripts/provision_tokenizer.py --from-file <approved-file>
# TIKTOKEN_CACHE_DIR=/approved/local/cache
